# Đổi tên file này thành .env hoặc mailtrap.env rồi điền thông tin Mailtrap thật của bạn.
# Nếu dùng Transactional SMTP như giao diện Mailtrap hiện tại, thường sẽ là:
# MAILTRAP_SMTP_USER=api
# MAILTRAP_SMTP_PASSWORD=<API token bạn tạo trong Mailtrap>
# Nếu dùng Sandbox SMTP để test giao diện/mail cục bộ, hãy đổi MAILTRAP_HOST thành
# sandbox.smtp.mailtrap.io và dùng đúng bộ credentials trong Mailtrap Sandbox.
# Khi dùng Sandbox, email sẽ chỉ xuất hiện trong Mailtrap inbox, không đi vào Gmail thật.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
MAILTRAP_HOST=live.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_SMTP_USER=api
MAILTRAP_SMTP_PASSWORD=your_mailtrap_api_token
MAILTRAP_USE_TLS=true
DEFAULT_FROM_EMAIL=hello@demomailtrap.co
EMAIL_TIMEOUT=30
PASSWORD_RESET_CODE_LENGTH=6
PASSWORD_RESET_CODE_TTL_MINUTES=10
